<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">proeis.rj.gov.br</domain>
        <domain includeSubdomains="true">policiamilitar.rj.gov.br</domain>
        <domain includeSubdomains="true">rj.gov.br</domain>
        <domain includeSubdomains="true">devsouza.online</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
